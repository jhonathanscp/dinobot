# Laravel BOT
APP_KEY= 
APP_VERSION=InDev
EVOLUTION_API_URL=value
EVOLUTION_API_KEY=senha
INSTANCE_NAME=bot-instance

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Evolution API
SERVER_URL=http://localhost:8080
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=senha_super_segura_api
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://admin:senha_segura_db@postgres:5432/evolution?schema=public
# Evolution conexão com o Redis
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379
CACHE_REDIS_PREFIX_KEY=evolution

# Postgres para Evolution
POSTGRES_USER=admin
POSTGRES_PASSWORD=senha_segura_db
POSTGRES_DB=evolution

